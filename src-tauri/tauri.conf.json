{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rely",
  "version": "1.0.0",
  "identifier": "work.mnexus.rely",
  "build": {
    "frontendDist": "../public",
    "beforeDevCommand": null,
    "beforeBuildCommand": null
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rely",
        "url": "https://rely.kz/",
        "width": 1100,
        "height": 760,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "appimage",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Rely by Nexus",
    "longDescription": "Rely — the AI workspace by Nexus / InDC."
  }
}
